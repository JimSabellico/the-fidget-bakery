{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/fidgets", "destination": "/index.html" },
    { "source": "/fidgets/:slug", "destination": "/index.html" },
    { "source": "/wiggles", "destination": "/index.html" },
    { "source": "/wiggles/:slug", "destination": "/index.html" },
    { "source": "/teachers", "destination": "/index.html" },
    { "source": "/custom", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
